{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "const": "REQUIREMENTS.md"
                  },
                  "line_start": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "line_end": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "file",
                  "line_start",
                  "line_end"
                ]
              }
            },
            "required": [
              "id",
              "description",
              "source"
            ]
          },
          "minItems": 1
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtime_contract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "binary_name": {
              "type": "string",
              "minLength": 1
            },
            "argv_contract": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "binary_name",
            "argv_contract"
          ]
        },
        "engineering_defaults": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "decision": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "decision",
              "source"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "protocol",
        "version",
        "role",
        "language",
        "runtime",
        "requirements",
        "required_capabilities",
        "excluded_features",
        "runtime_contract",
        "engineering_defaults"
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "enum": [
                  "message_format",
                  "state",
                  "interaction",
                  "transport",
                  "lifecycle",
                  "error"
                ]
              },
              "entity": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "values": {
                "type": "object"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "chunk_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line_start": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "line_end": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "chunk_id",
                    "line_start",
                    "line_end"
                  ]
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "category",
              "entity",
              "statement",
              "values",
              "evidence"
            ]
          },
          "minItems": 1
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schema_version",
        "facts",
        "open_questions"
      ]
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requirement_id": {
                "type": "string",
                "minLength": 1
              },
              "fact_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "spec_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "test_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "requirement_id",
              "fact_ids",
              "spec_refs",
              "test_ids"
            ]
          },
          "minItems": 1
        },
        "processing_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "spec_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "description",
              "spec_refs"
            ]
          },
          "minItems": 1
        },
        "engineering_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "spec_ref": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "enum": [
                  "engineering",
                  "requirement"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "spec_ref",
              "basis",
              "reason"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "requirements",
        "processing_chain",
        "engineering_decisions"
      ]
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "enum": [
            1,
            2
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "origin": {
          "enum": [
            "automatic",
            "manual_reference"
          ]
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "runtime_contract": {
          "$ref": "#/$defs/scope/properties/runtime_contract"
        },
        "module": {
          "const": "module_spec.json"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "spec": {
                "type": "string",
                "minLength": 1
              },
              "trace_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "spec",
              "trace_id",
              "path"
            ]
          }
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "spec": {
                "type": "string",
                "minLength": 1
              },
              "trace_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "spec",
              "trace_id",
              "name"
            ]
          }
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "artifact": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "artifact"
            ]
          }
        },
        "hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "required": [
        "schema_version",
        "revision",
        "origin",
        "protocol",
        "version",
        "role",
        "runtime_contract",
        "module",
        "files",
        "functions",
        "headers",
        "hashes"
      ]
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "requirement_ids": {
                "type": "array",
                "minItems": 0,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "spec_test_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "path",
              "requirement_ids",
              "spec_test_refs"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "files",
        "tests"
      ]
    }
  }
}
