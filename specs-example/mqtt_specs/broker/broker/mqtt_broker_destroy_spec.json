{
  "KIND": "FUNCTION_SPEC",
  "TRACE_ID": "mqtt/broker/broker/mqtt_broker_destroy",
  "FUNCTION_TYPE": "ALGORITHM",
  "ROLE": "销毁 Broker 运行时对象并按依赖顺序回收网络、路由与会话资源",
  "SIGNATURE": {
    "RAW": "void mqtt_broker_destroy(mqtt_broker_t* b)",
    "NAME": "mqtt_broker_destroy",
    "RETURN": "void",
    "PARAMS": [
      {
        "TYPE": "mqtt_broker_t*",
        "NAME": "b",
        "NULLABLE": true,
        "OWNERSHIP": "BORROWED"
      }
    ]
  },
  "RELY": {
    "STRUCT": [
      {
        "NAME": "struct mqtt_broker",
        "ROLE": "Broker 运行时内部状态结构"
      }
    ],
    "FUNC": [
      {
        "NAME": "mqtt_broker_stop",
        "KIND": "CALL",
        "ROLE": "先停止服务器运行循环"
      },
      {
        "NAME": "mqtt_tcp_server_destroy",
        "KIND": "CALL",
        "ROLE": "销毁网络服务器对象"
      },
      {
        "NAME": "mqtt_message_router_destroy",
        "KIND": "CALL",
        "ROLE": "销毁消息路由器"
      },
      {
        "NAME": "mqtt_session_manager_destroy",
        "KIND": "CALL",
        "ROLE": "销毁会话管理器"
      }
    ],
    "VAR": []
  },
  "LOGIC": {
    "INPUT": "输入为 broker 指针 b（可为 NULL）",
    "ACTION": "若 b 为空直接返回；否则先调用 mqtt_broker_stop，再销毁 tcp_server、router、session_manager，最后释放 b 本体",
    "OUTPUT": "无返回值；调用后 b 指向对象的资源被全部回收",
    "INVARIANTS_USED": [
      "销毁顺序与创建依赖相反，避免悬挂引用",
      "NULL 输入不产生副作用"
    ]
  }
