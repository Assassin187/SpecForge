            {
              "NAME": "MQTT_PKT_CONNECT",
              "VALUE": 1,
              "ROLE": "CONNECT 控制报文"
            },
            {
              "NAME": "MQTT_PKT_CONNACK",
              "VALUE": 2,
              "ROLE": "CONNACK 控制报文"
            },
