              "VALUE": 12,
              "ROLE": "PINGREQ 控制报文"
            },
            {
              "NAME": "MQTT_PKT_PINGRESP",
              "VALUE": 13,
              "ROLE": "PINGRESP 控制报文"
            },
            {
              "NAME": "MQTT_PKT_DISCONNECT",
              "VALUE": 14,
              "ROLE": "DISCONNECT 控制报文"
            }
          ]
        }
      },
      {
