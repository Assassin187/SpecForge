              "NAME": "MQTT_PKT_SUBSCRIBE",
              "VALUE": 8,
              "ROLE": "SUBSCRIBE 控制报文"
            },
            {
              "NAME": "MQTT_PKT_SUBACK",
              "VALUE": 9,
              "ROLE": "SUBACK 控制报文"
            },
            {
