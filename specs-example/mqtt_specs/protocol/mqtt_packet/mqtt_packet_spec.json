                    "NAME": "connect",
                    "TYPE": "mqtt_connect_payload_t",
                    "ROLE": "CONNECT 载荷，访问路径 mqtt_packet_t.v.connect"
                  },
                  {
                    "NAME": "publish",
                    "TYPE": "mqtt_publish_payload_t",
                    "ROLE": "PUBLISH 载荷，访问路径 mqtt_packet_t.v.publish"
                  },
                  {
                    "NAME": "subscribe",
                    "TYPE": "mqtt_subscribe_payload_t",
                    "ROLE": "SUBSCRIBE 载荷，访问路径 mqtt_packet_t.v.subscribe"
                  }
                ]
              }
            }
          ]
        }
      }
