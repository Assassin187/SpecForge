{
  "KIND": "FUNCTION_SPEC",
  "TRACE_ID": "mqtt/network/tcp_server/mqtt_tcp_server_start",
  "FUNCTION_TYPE": "ALGORITHM",
  "ROLE": "初始化监听与 epoll 资源并将服务器置为运行态",
  "SIGNATURE": {
    "RAW": "bool mqtt_tcp_server_start(mqtt_tcp_server_t* s)",
    "NAME": "mqtt_tcp_server_start",
    "RETURN": "bool",
    "PARAMS": [
      {
        "TYPE": "mqtt_tcp_server_t*",
        "NAME": "s",
        "NULLABLE": true,
        "OWNERSHIP": "BORROWED"
      }
    ]
  },
  "RELY": {
    "STRUCT": [
      {
        "NAME": "struct mqtt_tcp_server",
        "ROLE": "TCP 服务器私有状态结构体"
      }
    ],
    "FUNC": [
      {
        "NAME": "setup_listen_socket",
        "KIND": "CALL",
        "ROLE": "创建监听 socket"
      },
      {
        "NAME": "setup_epoll",
        "KIND": "CALL",
        "ROLE": "初始化 epoll 监听"
      }
    ],
    "VAR": []
  },
  "LOGIC": {
