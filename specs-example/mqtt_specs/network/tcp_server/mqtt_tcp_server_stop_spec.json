    "RETURN": "void",
    "PARAMS": [
      {
        "TYPE": "mqtt_tcp_server_t*",
        "NAME": "s",
        "NULLABLE": true,
        "OWNERSHIP": "BORROWED"
      }
    ]
  },
  "RELY": {
    "STRUCT": [
      {
        "NAME": "struct mqtt_tcp_server",
        "ROLE": "TCP 服务器私有状态结构体"
      }
    ],
    "FUNC": [
      {
        "NAME": "close_connection",
        "KIND": "CALL",
        "ROLE": "逐个关闭并移除连接"
