    "STRUCT": [],
    "FUNC": [],
    "VAR": []
  },
  "LOGIC": {
    "INPUT": "输入来自函数参数。",
    "ACTION": "calloc 分配 http_connection 结构体，设置 fd 字段，初始化 in_buf/out_buf 等缓冲字段为 NULL/0。",
    "OUTPUT": "成功返回连接对象指针，失败返回 NULL。",
    "INVARIANTS_USED": [
      "函数执行保持本模块内部状态一致性。"
    ]
  },
