{
  "KIND": "FUNCTION_SPEC",
  "TRACE_ID": "http/network/connection/http_connection_queue",
  "FUNCTION_TYPE": "ALGORITHM",
  "ROLE": "将原始字节追加到输出缓冲队列；自动扩容",
  "SIGNATURE": {
    "RAW": "int http_connection_queue(http_connection_t* conn, const void* data, size_t len)",
    "NAME": "http_connection_queue",
    "RETURN": "int",
    "PARAMS": [
      {
        "TYPE": "http_connection_t*",
        "NAME": "conn",
        "NULLABLE": false,
        "OWNERSHIP": "BORROWED"
      },
      {
        "TYPE": "const void*",
        "NAME": "data",
        "NULLABLE": true,
        "OWNERSHIP": "BORROWED"
      },
      {
        "TYPE": "size_t",
        "NAME": "len",
        "NULLABLE": false,
        "OWNERSHIP": "BORROWED"
      }
    ]
  },
  "RELY": {
    "STRUCT": [
      {
        "NAME": "struct http_connection",
        "ROLE": "连接私有状态结构体"
      }
    ],
    "FUNC": [
      {
        "NAME": "ensure_cap",
        "KIND": "CALL",
        "ROLE": "确保输出缓冲容量充足"
      }
    ],
    "VAR": []
  },
  "LOGIC": {
    "INPUT": "输入来自函数参数。",
    "ACTION": "校验参数（data==NULL 且 len!=0 返回 -1；len==0 返回 0）；调用 ensure_cap 确保 out_buf 容量 >= out_len+len；memcpy 追加数据到 out_buf+out_len 并更新 out_len。",
    "OUTPUT": "成功返回 0，失败返回 -1。"
  },
  "THREAD_SAFETY": "SINGLE_THREAD_ONLY",
  "IDEMPOTENT": false,
  "ACCESS_PATHS": [
    {
      "PATH": "conn->out_buf",
      "TYPE": "uint8_t*",
      "ROLE": "在 out_len 偏移处写入 len 字节"
    },
    {
      "PATH": "conn->out_len",
      "TYPE": "size_t",
      "ROLE": "追加入队后递增 len"
    },
    {
      "PATH": "conn->out_cap",
      "TYPE": "size_t",
      "ROLE": "容量不足时由 ensure_cap 更新"
    }
  ]
}
