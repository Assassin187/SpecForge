  "ROLE": "运行 epoll 事件循环：epoll_wait 1s 超时，分派 accept/read/write/close 事件",
  "SIGNATURE": {
    "RAW": "int http_tcp_server_run(http_tcp_server_t* server)",
    "NAME": "http_tcp_server_run",
    "RETURN": "int",
    "PARAMS": [
      {
        "TYPE": "http_tcp_server_t*",
        "NAME": "server",
        "NULLABLE": false,
        "OWNERSHIP": "BORROWED"
      }
    ]
  },
  "RELY": {
    "STRUCT": [
      {
        "NAME": "struct http_tcp_server",
        "ROLE": "TCP server 私有状态"
      },
      {
        "NAME": "http_client_node_t",
        "ROLE": "客户端链表节点"
      }
    ],
    "FUNC": [
      {
        "NAME": "accept_loop",
        "KIND": "CALL",
        "ROLE": "处理新连接接入"
