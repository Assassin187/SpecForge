{
  "KIND": "FUNCTION_SPEC",
  "TRACE_ID": "http/network/tcp_server/http_tcp_server_close_client",
  "FUNCTION_TYPE": "ALGORITHM",
  "ROLE": "从 epoll 删除 fd、close socket、从链表删除节点并触发 on_close 回调",
  "SIGNATURE": {
    "RAW": "int http_tcp_server_close_client(http_tcp_server_t* server, int fd)",
    "NAME": "http_tcp_server_close_client",
    "RETURN": "int",
    "PARAMS": [
      {
        "TYPE": "http_tcp_server_t*",
        "NAME": "server",
        "NULLABLE": false,
        "OWNERSHIP": "BORROWED"
      },
      {
        "TYPE": "int",
        "NAME": "fd",
        "NULLABLE": false,
        "OWNERSHIP": "BORROWED"
      }
    ]
  },
  "RELY": {
    "STRUCT": [
      {
        "NAME": "struct http_tcp_server",
        "ROLE": "TCP server 私有状态"
      },
      {
        "NAME": "http_client_node_t",
        "ROLE": "客户端链表节点"
      }
    ],
    "FUNC": [
      {
        "NAME": "find_client",
        "KIND": "CALL",
        "ROLE": "按 fd 定位客户端节点"
      },
      {
        "NAME": "remove_client_node",
        "KIND": "CALL",
        "ROLE": "从链表移除并释放节点"
      }
    ],
    "VAR": []
  },
  "LOGIC": {
    "INPUT": "输入 server 和 fd。",
    "ACTION": "find_client 查找→epoll_ctl EPOLL_CTL_DEL→close(fd)→remove_client_node→on_close 回调。",
    "OUTPUT": "成功返回 0，未找到返回 -1。",
    "INVARIANTS_USED": [
      "仅面向单线程事件循环或单线程调用路径；跨线程访问必须由上层同步。",
      "函数可能分配资源、消费缓冲、修改链表、写文件或更新网络状态，不承诺幂等。",
      "调用方必须遵守 SIGNATURE.PARAMS 中的 NULLABLE 与 OWNERSHIP 约束。"
    ]
  }
}
