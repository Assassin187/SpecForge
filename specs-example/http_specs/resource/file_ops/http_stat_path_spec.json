  "ROLE": "对路径执行 stat；返回 0=普通文件, 1=目录, -1=不存在/无权限",
  "SIGNATURE": {
    "RAW": "int http_stat_path(const char* abs_path)",
    "NAME": "http_stat_path",
    "RETURN": "int",
    "PARAMS": [
      {
        "TYPE": "const char*",
        "NAME": "abs_path",
        "NULLABLE": false,
        "OWNERSHIP": "BORROWED"
      }
    ]
  },
  "RELY": {
    "STRUCT": [],
    "FUNC": [],
    "VAR": []
  },
  "LOGIC": {
    "INPUT": "输入绝对路径。",
    "ACTION": "stat 获取文件信息→S_ISREG 返回 0→S_ISDIR 返回 1→其他返回 -1。",
    "OUTPUT": "返回路径类型判别码。",
    "INVARIANTS_USED": [
