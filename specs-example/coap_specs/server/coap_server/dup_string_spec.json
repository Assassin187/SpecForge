{
  "KIND": "FUNCTION_SPEC",
  "TRACE_ID": "coap/server/coap_server/dup_string",
  "FUNCTION_TYPE": "ALGORITHM",
  "ROLE": "分配并复制 NUL-terminated 字符串；NULL 返回 NULL",
  "SIGNATURE": {
    "RAW": "static char* dup_string(const char* s)",
    "NAME": "dup_string",
    "RETURN": "char*",
    "PARAMS": [
      {
        "TYPE": "const char*",
        "NAME": "s",
        "NULLABLE": true,
        "OWNERSHIP": "BORROWED"
      }
    ]
  },
  "RELY": {
    "STRUCT": [],
    "FUNC": [],
    "VAR": []
  },
  "LOGIC": {
    "INPUT": "s 是可空 NUL-terminated string。",
    "ACTION": "若 s 为空返回 NULL。否则分配 strlen(s) + 1 bytes，并复制包含 NUL terminator 的完整字符串。",
    "OUTPUT": "成功返回新分配字符串；输入为空或分配失败返回 NULL。调用方负责 free。",
    "INVARIANTS_USED": [
      "复制内容包含结尾 NUL。"
    ]
  }
}
