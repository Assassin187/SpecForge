{
  "KIND": "FUNCTION_SPEC",
  "TRACE_ID": "coap/protocol/coap_message/coap_make_code",
  "FUNCTION_TYPE": "ALGORITHM",
  "ROLE": "将 3-bit class 与 5-bit detail 合成为 CoAP code",
  "SIGNATURE": {
    "RAW": "uint8_t coap_make_code(uint8_t code_class, uint8_t detail)",
    "NAME": "coap_make_code",
    "RETURN": "uint8_t",
    "PARAMS": [
      {
        "TYPE": "uint8_t",
        "NAME": "code_class",
        "NULLABLE": false,
        "OWNERSHIP": "BORROWED"
      },
      {
        "TYPE": "uint8_t",
        "NAME": "detail",
        "NULLABLE": false,
        "OWNERSHIP": "BORROWED"
      }
    ]
  },
  "RELY": {
    "STRUCT": [],
    "FUNC": [],
    "VAR": []
  },
  "LOGIC": {
    "INPUT": "code_class 与 detail 是待组合的 CoAP code 部分。",
    "ACTION": "计算 ((code_class & 0x7u) << 5) | (detail & 0x1fu)，并转换为 uint8_t。",
    "OUTPUT": "返回 3-bit class 与 5-bit detail 合成后的 code byte。",
    "INVARIANTS_USED": [
      "class 只保留低 3 bits；detail 只保留低 5 bits。"
    ]
  }
}
