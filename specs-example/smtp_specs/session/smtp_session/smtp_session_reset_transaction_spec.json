    ],
    "FUNC": [],
    "VAR": []
  },
  "LOGIC": {
    "INPUT": "输入参数：session(smtp_session_t*，可为 NULL，BORROWED)。",
    "ACTION": "清空 MAIL/RCPT/DATA transaction 状态，不影响 greeting/authenticated。",
    "OUTPUT": "无返回值；副作用为清空 MAIL/RCPT/DATA transaction 状态，不影响 greeting/authenticated。",
    "INVARIANTS_USED": [
      "仅面向单线程事件循环或单线程调用路径；跨线程访问必须由上层同步。",
