{
  "KIND": "FUNCTION_SPEC",
  "TRACE_ID": "smtp/protocol_text/smtp_command/smtp_command_parse",
  "FUNCTION_TYPE": "ALGORITHM",
  "ROLE": "解析单行 SMTP 命令，跳过前导空白、verb 大写化、复制并右裁剪参数",
  "SIGNATURE": {
    "RAW": "int smtp_command_parse(const char* line, smtp_command_t* out)",
    "NAME": "smtp_command_parse",
    "RETURN": "int",
    "PARAMS": [
      {
        "TYPE": "const char*",
        "NAME": "line",
        "NULLABLE": true,
        "OWNERSHIP": "BORROWED"
      },
      {
        "TYPE": "smtp_command_t*",
        "NAME": "out",
        "NULLABLE": true,
        "OWNERSHIP": "BORROWED"
      }
    ]
  },
  "RELY": {
    "STRUCT": [
      {
        "NAME": "smtp_command_t",
        "ROLE": "该函数读取或维护的结构化状态"
      }
    ],
    "FUNC": [
      {
        "NAME": "parse_kind",
        "KIND": "CALL",
        "ROLE": "被该函数调用以完成子步骤"
      }
    ],
    "VAR": []
  },
  "LOGIC": {
    "INPUT": "输入为 int smtp_command_parse(const char* line, smtp_command_t* out) 的参数集合。",
    "ACTION": "解析单行 SMTP 命令，跳过前导空白、verb 大写化、复制并右裁剪参数",
    "OUTPUT": "按签名返回成功/失败、对象指针、格式化长度或无返回值；失败路径遵循当前 C 实现。",
    "INVARIANTS_USED": [
      "不引入当前源码不存在的 SMTP 扩展或额外协议状态。",
      "所有缓冲写入必须受目标容量约束保护。"
    ]
  },
  "ACCESS_PATHS": [
    {
      "PATH": "smtp_command_t.kind",
      "TYPE": "smtp_command_kind_t",
      "ROLE": "写入命令类型"
    },
    {
      "PATH": "smtp_command_t.arg",
      "TYPE": "char[1024]",
      "ROLE": "写入参数副本"
    },
    {
      "PATH": "smtp_command_t.has_arg",
      "TYPE": "bool",
      "ROLE": "写入参数存在标志"
    }
  ],
  "WIRE_MAPPING": [
    {
      "PACKET": "SMTP_COMMAND",
      "WIRE_FIELD": "verb",
      "STRATEGY": "store_in_field",
      "RULE": "第一个空白分隔 token 大写后决定 kind",
      "TARGET": "smtp_command_t.kind"
    },
    {
      "PACKET": "SMTP_COMMAND",
      "WIRE_FIELD": "argument",
      "STRATEGY": "store_in_field",
      "RULE": "verb 后剩余非空文本右裁剪后复制到 arg",
      "TARGET": "smtp_command_t.arg"
    },
    {
      "PACKET": "SMTP_COMMAND",
      "WIRE_FIELD": "has_argument",
      "STRATEGY": "store_in_field",
      "RULE": "argument 非空时为 true",
      "TARGET": "smtp_command_t.has_arg"
    }
  ],
  "TEST_VECTORS": [
    {
      "NAME": "ehlo_case_insensitive",
      "LEVEL": "FUNCTION",
      "INPUT": {
        "line": "ehlo localhost"
      },
      "EXPECT": {
        "return": 0,
        "kind": "SMTP_CMD_EHLO",
        "arg": "localhost"
      }
    }
  ]
