{
  "schema_version": "protocol_facts/v2alpha1",
  "protocol_meta": {
    "protocol_name": "smtp"
  },
  "transport": {
    "network_stack": {
      "value": "tcp",
      "evidence_refs": ["smtp_transport"]
    },
    "connection_model": {
      "value": "connection_oriented",
      "evidence_refs": ["smtp_transport"]
    }
  },
  "interaction_model": {
    "style": {
      "value": "command_response",
      "evidence_refs": ["smtp_roles"]
    },
    "roles": [
      {
        "name": "client",
        "evidence_refs": ["smtp_roles"]
      },
      {
        "name": "server",
        "evidence_refs": ["smtp_roles"]
      }
    ]
  },
  "message_model": {
    "surface_catalog": [
      {
        "name": "HELO",
        "summary": "Begin a mail session and identify the client.",
        "evidence_refs": ["smtp_helo"]
      },
      {
        "name": "MAIL",
        "summary": "Begin a mail transaction with an envelope sender.",
        "evidence_refs": ["smtp_mail"]
      },
      {
        "name": "RCPT",
        "summary": "Add an envelope recipient.",
        "evidence_refs": ["smtp_rcpt"]
      },
      {
        "name": "DATA",
        "summary": "Submit message content after envelope recipients exist.",
        "evidence_refs": ["smtp_data"]
      },
      {
        "name": "QUIT",
        "summary": "Terminate the SMTP session.",
        "evidence_refs": ["smtp_quit"]
      }
    ],
    "message_or_command_entries": [
      {
        "name": "line_command",
        "summary": "Commands are line-oriented verbs with arguments.",
        "evidence_refs": ["smtp_command_syntax"]
      },
      {
        "name": "reply",
        "summary": "Replies carry status codes and text.",
        "evidence_refs": ["smtp_reply_syntax"]
      }
    ]
  },
  "state_model": {
    "state_nodes": [
      {
        "name": "greeted",
        "summary": "Client has identified itself.",
        "evidence_refs": ["smtp_helo"]
      },
      {
        "name": "mail_transaction",
        "summary": "Envelope sender and recipients are being collected.",
        "evidence_refs": ["smtp_mail", "smtp_rcpt"]
      },
      {
        "name": "receiving_data",
        "summary": "Server is accepting message content.",
        "evidence_refs": ["smtp_data"]
      },
      {
        "name": "closed",
        "summary": "Session has ended.",
        "evidence_refs": ["smtp_quit"]
      }
    ],
    "transitions": [
      {
        "from_state": "greeted",
        "to_state": "mail_transaction",
        "trigger": "MAIL",
        "summary": "MAIL starts an envelope transaction.",
        "evidence_refs": ["smtp_mail"]
      },
      {
        "from_state": "mail_transaction",
        "to_state": "receiving_data",
        "trigger": "DATA after at least one RCPT",
        "summary": "DATA begins content transfer.",
        "evidence_refs": ["smtp_data"]
      },
      {
        "from_state": "receiving_data",
        "to_state": "greeted",
        "trigger": "message terminator",
        "summary": "Completed message resets the transaction state.",
        "evidence_refs": ["smtp_data"]
      }
    ],
    "timers_and_constants": []
  },
  "routing_model": {
    "dispatch_keys": [
      {
        "name": "command_verb",
        "summary": "Command verb selects session behavior.",
        "evidence_refs": ["smtp_command_syntax"]
      }
    ]
  },
  "resource_model": {
    "persistence_scope": null,
    "resource_objects": [
      {
        "name": "mail_session",
        "scope": "connection",
        "summary": "Tracks greeting state and active envelope transaction.",
        "evidence_refs": ["smtp_mail", "smtp_rcpt"]
      },
      {
        "name": "mail_transaction",
        "scope": "message",
        "summary": "Owns sender, recipients, and received content for one message.",
        "evidence_refs": ["smtp_data"]
      }
    ],
    "lifecycle_rules": [
      {
        "summary": "Create session state on connection and clear transaction state after DATA completes.",
        "evidence_refs": ["smtp_data"]
      }
    ]
  },
  "error_and_limits": {
    "error_matrix": [
      {
        "condition": "DATA before MAIL or RCPT",
        "surface_unit": "DATA",
        "required_action": "reply with an error status and keep the session open",
        "evidence_refs": ["smtp_error"]
      }
    ]
  },
  "minimum_v1": {
    "must_support_surface": [
      {
        "name": "HELO",
        "summary": "Accept greeting.",
        "evidence_refs": ["smtp_helo"]
      },
      {
        "name": "MAIL",
        "summary": "Start envelope transaction.",
        "evidence_refs": ["smtp_mail"]
      },
      {
        "name": "RCPT",
        "summary": "Record envelope recipient.",
        "evidence_refs": ["smtp_rcpt"]
      },
      {
        "name": "DATA",
        "summary": "Accept message content after a valid envelope.",
        "evidence_refs": ["smtp_data"]
      },
      {
        "name": "QUIT",
        "summary": "Close the session.",
        "evidence_refs": ["smtp_quit"]
      }
    ],
    "may_defer_features": [
      {
        "name": "authentication",
        "summary": "Authentication and authorization are outside minimum scope.",
        "evidence_refs": ["smtp_scope"]
      }
    ],
    "implementation_assumptions": [
      {
        "name": "single_process_memory_queue",
        "summary": "Accepted mail content can remain in memory for minimum validation.",
        "evidence_refs": ["smtp_scope"]
      }
    ]
  },
  "open_questions": [],
  "evidence_index": [
    {"evidence_id": "smtp_transport", "summary": "SMTP uses a TCP command channel."},
    {"evidence_id": "smtp_roles", "summary": "SMTP uses client/server command response roles."},
    {"evidence_id": "smtp_command_syntax", "summary": "Commands are line-oriented verbs."},
    {"evidence_id": "smtp_reply_syntax", "summary": "Replies include status codes."},
    {"evidence_id": "smtp_helo", "summary": "HELO identifies the client."},
    {"evidence_id": "smtp_mail", "summary": "MAIL begins the envelope."},
    {"evidence_id": "smtp_rcpt", "summary": "RCPT adds a recipient."},
    {"evidence_id": "smtp_data", "summary": "DATA accepts message content."},
    {"evidence_id": "smtp_quit", "summary": "QUIT closes the session."},
    {"evidence_id": "smtp_error", "summary": "Invalid command order is rejected with a reply."},
    {"evidence_id": "smtp_scope", "summary": "Minimum scope excludes authentication."}
  ]
}
