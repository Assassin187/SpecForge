{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_spec", "files", "headers", "functions", "requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "project_spec": {"const": "project.spec"},
    "files": {"type": "array", "minItems": 2, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "spec"],
      "properties": {"path": {"type": "string"}, "spec": {"type": "string"}}
    }},
    "headers": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "artifact"],
      "properties": {"path": {"type": "string"}, "artifact": {"type": "string"}}
    }},
    "functions": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "source", "spec", "signature"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"},
        "source": {"type": "string"}, "spec": {"type": "string"},
        "signature": {"type": "string", "minLength": 1}, "header": {"type": "string"}
      }
    }},
    "requirements": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "spec_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "spec_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }}
  }
}
