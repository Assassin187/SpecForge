        "ROLE": "Connection lifecycle state",
        "TYPE_SPEC": {
          "TYPE_KIND": "ENUM",
          "ENUM_VALUES": [
            {
              "NAME": "SESSION_AWAITING_CONNECT",
              "VALUE": 0,
              "ROLE": "Created, no CONNECT processed yet"
            },
            {
              "NAME": "SESSION_READY",
              "VALUE": 1,
              "ROLE": "CONNECT accepted, responses may be queued"
            },
            {
              "NAME": "SESSION_CLOSING",
              "VALUE": 2,
              "ROLE": "No more input; queued output must flush"
            },
            {
              "NAME": "SESSION_CLOSED",
              "VALUE": 3,
