  "TEST_VECTORS": [
    {
      "NAME": "lifecycle_connect_ready_close_is_idempotent",
      "INPUT": {
        "runtime": [
          "socketpair() to obtain a real fd",
          "session_create(fd, &s)",
          "session_state(s)",
          "session_mark_ready(s)",
          "session_state(s)",
          "session_close_immediately(s)",
          "session_close_immediately(s)",
          "session_fd(s)",
          "session_destroy(s)"
        ]
      },
      "EXPECT": {
        "create_return": 0,
        "initial_state": "SESSION_AWAITING_CONNECT",
        "state_after_ready": "SESSION_READY",
        "fd_after_close": -1,
        "double_close_safe": true,
        "peers_see_eof": true
      },
      "LEVEL": "RUNTIME",
      "TRACE_REFS": [
        "src/session.c/session_create",
        "src/session.c/session_mark_ready",
        "src/session.c/session_close_immediately",
        "src/session.c/session_destroy"
      ]
    },
    {
      "NAME": "create_rejects_null_and_leaves_fd_open",
      "INPUT": {
        "args": [
          "session_create(5, NULL)",
          "session_create(-1, &s)"
        ]
      },
      "EXPECT": {
        "return": [
          -1,
          -1
        ],
        "fd_not_closed": true,
        "out_session_untouched": true
      },
      "LEVEL": "FUNCTION",
      "TRACE_REFS": [
        "src/session.c/session_create"
      ]
    },
    {
      "NAME": "enqueue_appends_without_replacing_existing_output",
      "INPUT": {
        "runtime": [
          "session_enqueue(s, \"\\x20\\x02\\x00\\x00\", 4)",
          "session_enqueue(s, \"\\xd0\\x00\", 2)",
          "session_enqueue(s, \"\", 0)"
        ]
      },
      "EXPECT": {
        "return": [
          0,
          0,
          0
        ],
        "output_len": 6,
        "first_six_bytes": "20 02 00 00 d0 00",
        "note": "the second enqueue must not free or overwrite the first packet's bytes"
      },
      "LEVEL": "FUNCTION",
      "TRACE_REFS": [
        "src/session.c/session_enqueue",
        "src/session.c/session_output"
      ]
    },
    {
      "NAME": "set_client_id_replaces_previous_copy_without_leaking",
      "INPUT": {
        "runtime": [
          "session_set_client_id(s, \"abc\", 3)",
          "session_client_id(s, &n)",
          "session_set_client_id(s, \"wxyz\", 4)",
          "session_client_id(s, &n)",
          "session_set_client_id(s, NULL, 1)"
        ]
      },
      "EXPECT": {
        "return": [
          0,
          0,
          -1
        ],
        "len_after_first": 3,
        "len_after_second": 4,
        "id_after_second": "wxyz",
        "old_copy_released": true
      },
      "LEVEL": "FUNCTION",
      "TRACE_REFS": [
        "src/session.c/session_set_client_id",
        "src/session.c/session_client_id"
      ]
    },
    {
      "NAME": "add_subscription_replaces_identical_filter_in_place",
      "INPUT": {
        "runtime": [
          "session_add_subscription(s, \"a/b\", 3, 0)",
          "session_add_subscription(s, \"a/+\", 3, 1)",
          "session_add_subscription(s, \"a/b\", 3, 0)",
          "session_subscription_count(s)",
          "session_subscription_at(s, 0)",
          "session_subscription_at(s, 1)",
          "session_subscription_at(s, 2)"
        ]
      },
      "EXPECT": {
        "return": [
          0,
          0,
